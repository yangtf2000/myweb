<script>
(function(){
  var d = new Date();
  var key = 'cet-task-' + d.getFullYear() + '-' + (d.getMonth() + 1) + '-' + d.getDate();
  var saved = {};
  try { saved = JSON.parse(localStorage.getItem(key) || '{}'); } catch (e) { saved = {}; }
  var boxes = document.querySelectorAll('.task input[data-k]');
  for (var i = 0; i < boxes.length; i++) {
    var el = boxes[i];
    el.checked = !!saved[el.getAttribute('data-k')];
    el.addEventListener('change', function(){
      saved[this.getAttribute('data-k')] = this.checked;
      try { localStorage.setItem(key, JSON.stringify(saved)); } catch (e) {}
    });
  }
  try {
    var stale = [];
    for (var k in localStorage) {
      if (k.indexOf('cet-task-') === 0 && k !== key) stale.push(k);
    }
    for (var j = 0; j < stale.length; j++) localStorage.removeItem(stale[j]);
  } catch (e) {}
})();
</script>
